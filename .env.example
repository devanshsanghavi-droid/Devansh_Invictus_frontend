# Environment Configuration
# Copy this file to .env.local and update values as needed

# API Configuration (used when Sanity is not configured)
# Base URL for the blog API
# Default: https://staging.trilio.ai/api/auth/v1
VITE_API_BASE_URL=https://staging.trilio.ai/api/auth/v1

# Sanity CMS (optional – when set, blogs are fetched from Sanity instead of the API)
# Create a project at https://sanity.io/manage and run schema deploy from ./sanity
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
# Required only for migrating blogs from API to Sanity (scripts/migrate-blogs-to-sanity.js)
# Create token at sanity.io/manage → API → Tokens (Editor)
# SANITY_API_TOKEN=

# Optional: for scripts/generate-blog-sitemap.js to fetch slugs from Sanity instead of legacy API
# SANITY_PROJECT_ID=your-project-id
# SANITY_DATASET=production
